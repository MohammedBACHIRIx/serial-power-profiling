{
  "db_path": "%LOCALAPPDATA%/powerprofiler/powerprofiler-wiznet.db",
  "sample_batch_ms": 250,
  "devices": [
    {
      "name": "PSU-MAINS",
      "role": "input",
      "pair": "PSU-DC-OUT",
      "model": "ISW8001",
      "transport": "tcp",
      "tcp_host": "192.168.1.150",
      "tcp_port": 5000,
      "init": { "function": "WATT", "auto_mode": true, "autorange": true },
      "alerts": { "power_w_max": 2500, "voltage_v_max": 260, "voltage_v_min": 190, "stale_seconds": 5 }
    },
    {
      "name": "PSU-DC-OUT",
      "role": "output",
      "pair": "PSU-MAINS",
      "model": "ISW8001",
      "transport": "serial",
      "port": "COM4",
      "baud": 9600,
      "init": { "function": "WATT", "auto_mode": true, "autorange": true },
      "alerts": { "power_w_max": 2000, "stale_seconds": 5 }
    }
  ]
}
